{
  "alias": "Heizung neu starten",
  "description": "Einmaliger manueller Betriebswechsel nach behobener Ursache. Kein elektrischer Neustart und kein nachgewiesener Fehlerquittierbefehl. Bricht bei unbestätigten Schritten ab; kein automatischer Wiederanlauf nach HA-Neustart. Werte werden absichtlich einzeln und mit Rückmeldung restauriert, nicht gleichzeitig über eine Szene.",
  "icon": "mdi:restart",
  "mode": "single",
  "max_exceeded": "warning",
  "trace": {
    "stored_traces": 10
  },
  "fields": {
    "cause_resolved": {
      "name": "Ursache behoben",
      "description": "Die Ursache wurde behoben; Heizung und Warmwasser dürfen wieder anlaufen.",
      "required": true,
      "default": false,
      "selector": {
        "boolean": {}
      }
    }
  },
  "variables": {
    "notify_service": ""
  },
  "sequence": [
    {
      "if": [
        {
          "condition": "not",
          "conditions": [
            {
              "condition": "and",
              "conditions": [
                {
                  "condition": "template",
                  "value_template": "{{ cause_resolved | default(false) == true }}"
                }
              ]
            }
          ]
        }
      ],
      "then": [
        {
          "action": "persistent_notification.create",
          "data": {
            "title": "Truma · Heizung neu starten",
            "message": "Nicht gestartet: Ursache zuerst beheben und den Neustart ausdrücklich bestätigen.",
            "notification_id": "truma_heater_restart"
          }
        },
        {
          "if": [
            {
              "condition": "template",
              "value_template": "{{ notify_service | default('') != '' }}"
            }
          ],
          "then": [
            {
              "action": "{{ notify_service }}",
              "continue_on_error": true,
              "data": {
                "title": "Truma · Heizung neu starten",
                "message": "Nicht gestartet: Ursache zuerst beheben und den Neustart ausdrücklich bestätigen.",
                "data": {
                  "tag": "truma_heater_restart",
                  "channel": "Truma Meldungen",
                  "clickAction": "/wohnmobil-klima/klima",
                  "url": "/wohnmobil-klima/klima"
                }
              }
            }
          ]
        },
        {
          "stop": "Nicht gestartet: Ursache zuerst beheben und den Neustart ausdrücklich bestätigen.",
          "error": true
