        },
        {
          "action": "climate.set_fan_mode",
          "target": {
            "entity_id": "climate.truma_inet_heizung"
          },
          "data": {
            "fan_mode": "{{ saved_fan }}"
          },
          "continue_on_error": true
        },
        {
          "wait_template": "{{ state_attr('climate.truma_inet_heizung','fan_mode') == saved_fan and is_state('binary_sensor.truma_inet_verbindung','on') }}",
          "timeout": {
            "seconds": 20
          },
          "continue_on_timeout": true
        },
        {
          "if": [
            {
              "condition": "not",
              "conditions": [
                {
                  "condition": "and",
                  "conditions": [
                    {
                      "condition": "template",
                      "value_template": "{{ wait.completed }}"
                    }
                  ]
                }
              ]
            }
          ],
          "then": [
            {
              "action": "persistent_notification.create",
              "data": {
                "title": "Truma · Heizung neu starten",
                "message": "Lüfterstufe wurde nicht bestätigt. Neustart abgebrochen; Einstellungen können teilweise verändert sein. Kein weiterer Versuch.",
                "notification_id": "truma_heater_restart"
              }
            },
            {
              "if": [
                {
                  "condition": "template",
                  "value_template": "{{ notify_service | default('') != '' }}"
                }
              ],
              "then": [
                {
                  "action": "{{ notify_service }}",
                  "continue_on_error": true,
                  "data": {
                    "title": "Truma · Heizung neu starten",
                    "message": "Lüfterstufe wurde nicht bestätigt. Neustart abgebrochen; Einstellungen können teilweise verändert sein. Kein weiterer Versuch.",
                    "data": {
                      "tag": "truma_heater_restart",
                      "channel": "Truma Meldungen",
                      "clickAction": "/wohnmobil-klima/klima",
                      "url": "/wohnmobil-klima/klima"
                    }
                  }
                }
              ]
            },
            {
              "stop": "Lüfterstufe wurde nicht bestätigt. Neustart abgebrochen; Einstellungen können teilweise verändert sein. Kein weiterer Versuch.",
              "error": true
            }
          ]
        }
      ]
    },
    {
      "if": [
        {
          "condition": "not",
          "conditions": [
            {
              "condition": "and",
              "conditions": [
                {
                  "condition": "state",
                  "entity_id": "binary_sensor.truma_inet_verbindung",
                  "state": "on"
                },
                {
                  "condition": "state",
                  "entity_id": "sensor.truma_inet_timer",
                  "state": "Aus"
                }
              ]
            }
          ]
        }
      ],
      "then": [
        {
          "action": "persistent_notification.create",
          "data": {
            "title": "Truma · Heizung neu starten",
            "message": "Neustart abgebrochen: Verbindung fehlt oder der Gerätetimer ist nicht aus. Einstellungen bitte prüfen.",
            "notification_id": "truma_heater_restart"
          }
        },
        {
          "if": [
            {
              "condition": "template",
              "value_template": "{{ notify_service | default('') != '' }}"
            }
          ],
          "then": [
            {
              "action": "{{ notify_service }}",
              "continue_on_error": true,
              "data": {
                "title": "Truma · Heizung neu starten",
                "message": "Neustart abgebrochen: Verbindung fehlt oder der Gerätetimer ist nicht aus. Einstellungen bitte prüfen.",
                "data": {
                  "tag": "truma_heater_restart",
                  "channel": "Truma Meldungen",
                  "clickAction": "/wohnmobil-klima/klima",
                  "url": "/wohnmobil-klima/klima"
