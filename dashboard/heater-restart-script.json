        },
        {
          "stop": "Neustart abgebrochen: Verbindung fehlt oder der Gerätetimer ist nicht aus. Einstellungen bitte prüfen.",
          "error": true
        }
      ]
    },
    {
      "action": "select.select_option",
      "target": {
        "entity_id": "select.truma_inet_warmwasser"
      },
      "data": {
        "option": "{{ saved_water }}"
      },
      "continue_on_error": true
    },
    {
      "wait_template": "{{ is_state('select.truma_inet_warmwasser',saved_water) and is_state('binary_sensor.truma_inet_verbindung','on') }}",
      "timeout": {
        "seconds": 20
      },
      "continue_on_timeout": true
    },
    {
      "if": [
        {
          "condition": "not",
          "conditions": [
            {
              "condition": "and",
              "conditions": [
                {
                  "condition": "template",
                  "value_template": "{{ wait.completed }}"
                }
              ]
            }
          ]
        }
      ],
      "then": [
        {
          "action": "persistent_notification.create",
          "data": {
            "title": "Truma · Heizung neu starten",
            "message": "Warmwasser wiederherstellen wurde nicht bestätigt. Neustart abgebrochen; Einstellungen können teilweise verändert sein. Kein weiterer Versuch.",
            "notification_id": "truma_heater_restart"
          }
        },
        {
          "if": [
            {
              "condition": "template",
              "value_template": "{{ notify_service | default('') != '' }}"
            }
          ],
          "then": [
            {
              "action": "{{ notify_service }}",
              "continue_on_error": true,
              "data": {
                "title": "Truma · Heizung neu starten",
                "message": "Warmwasser wiederherstellen wurde nicht bestätigt. Neustart abgebrochen; Einstellungen können teilweise verändert sein. Kein weiterer Versuch.",
                "data": {
                  "tag": "truma_heater_restart",
                  "channel": "Truma Meldungen",
                  "clickAction": "/wohnmobil-klima/klima",
                  "url": "/wohnmobil-klima/klima"
                }
              }
            }
          ]
        },
        {
          "stop": "Warmwasser wiederherstellen wurde nicht bestätigt. Neustart abgebrochen; Einstellungen können teilweise verändert sein. Kein weiterer Versuch.",
          "error": true
        }
      ]
    },
    {
      "variables": {
        "verify_after": "{{ now().isoformat() }}"
      }
    },
    {
      "wait_template": "{{ is_state('binary_sensor.truma_inet_verbindung','on') and state_attr('sensor.truma_inet_meldungen','fresh') == true and as_timestamp(state_attr('sensor.truma_inet_meldungen','checked'),0) > as_timestamp(verify_after) }}",
      "timeout": {
        "seconds": 30
      },
      "continue_on_timeout": true
    },
    {
      "if": [
        {
          "condition": "not",
          "conditions": [
            {
              "condition": "and",
              "conditions": [
                {
                  "condition": "template",
                  "value_template": "{{ wait.completed }}"
                }
              ]
            }
          ]
        }
      ],
      "then": [
        {
          "action": "persistent_notification.create",
          "data": {
            "title": "Truma · Heizung neu starten",
            "message": "Betriebswerte wiederhergestellt, aber der Fehlerstatus konnte nicht frisch geprüft werden. Bitte am Bedienpanel prüfen.",
            "notification_id": "truma_heater_restart"
          }
        },
        {
          "if": [
            {
              "condition": "template",
              "value_template": "{{ notify_service | default('') != '' }}"
            }
          ],
          "then": [
            {
              "action": "{{ notify_service }}",
              "continue_on_error": true,
              "data": {
                "title": "Truma · Heizung neu starten",
                "message": "Betriebswerte wiederhergestellt, aber der Fehlerstatus konnte nicht frisch geprüft werden. Bitte am Bedienpanel prüfen.",
                "data": {
                  "tag": "truma_heater_restart",
                  "channel": "Truma Meldungen",
                  "clickAction": "/wohnmobil-klima/klima",
                  "url": "/wohnmobil-klima/klima"
                }
              }
            }
          ]
        },
        {
          "stop": "Betriebswerte wiederhergestellt, aber der Fehlerstatus konnte nicht frisch geprüft werden. Bitte am Bedienpanel prüfen.",
          "error": true
        }
      ]
    },
    {
      "if": [
        {
          "condition": "not",
          "conditions": [
            {
              "condition": "and",
              "conditions": [
                {
                  "condition": "template",
                  "value_template": "{{ is_state('climate.truma_inet_heizung',saved_mode) and (saved_mode == 'off' or (state_attr('climate.truma_inet_heizung','temperature') == saved_target and state_attr('climate.truma_inet_heizung','fan_mode') == saved_fan)) and is_state('select.truma_inet_warmwasser',saved_water) }}"
                }
              ]
            }
          ]
        }
      ],
      "then": [
        {
          "action": "persistent_notification.create",
          "data": {
            "title": "Truma · Heizung neu starten",
            "message": "Neustart nicht bestätigt: Betriebswerte stimmen nicht mit dem vorherigen Stand überein. Bitte prüfen.",
            "notification_id": "truma_heater_restart"
          }
        },
        {
          "if": [
            {
              "condition": "template",
              "value_template": "{{ notify_service | default('') != '' }}"
            }
          ],
          "then": [
            {
              "action": "{{ notify_service }}",
              "continue_on_error": true,
              "data": {
                "title": "Truma · Heizung neu starten",
                "message": "Neustart nicht bestätigt: Betriebswerte stimmen nicht mit dem vorherigen Stand überein. Bitte prüfen.",
                "data": {
                  "tag": "truma_heater_restart",
                  "channel": "Truma Meldungen",
                  "clickAction": "/wohnmobil-klima/klima",
                  "url": "/wohnmobil-klima/klima"
                }
              }
            }
          ]
        },
        {
          "stop": "Neustart nicht bestätigt: Betriebswerte stimmen nicht mit dem vorherigen Stand überein. Bitte prüfen.",
          "error": true
        }
      ]
    },
    {
      "if": [
        {
          "condition": "template",
          "value_template": "{{ (state_attr('sensor.truma_inet_meldungen','active') or []) | selectattr('source','equalto','heater') | list | length > 0 }}"
        }
      ],
      "then": [
        {
          "action": "persistent_notification.create",
          "data": {
            "title": "Truma · Heizung neu starten",
            "message": "Aus- und Einschalten bestätigt. Die Heizung meldet weiterhin eine Warnung oder Störung. Bitte am Bedienpanel prüfen; kein weiterer Neustart.",
            "notification_id": "truma_heater_restart"
          }
        },
        {
          "if": [
            {
              "condition": "template",
              "value_template": "{{ notify_service | default('') != '' }}"
            }
          ],
          "then": [
            {
              "action": "{{ notify_service }}",
              "continue_on_error": true,
              "data": {
                "title": "Truma · Heizung neu starten",
                "message": "Aus- und Einschalten bestätigt. Die Heizung meldet weiterhin eine Warnung oder Störung. Bitte am Bedienpanel prüfen; kein weiterer Neustart.",
                "data": {
                  "tag": "truma_heater_restart",
                  "channel": "Truma Meldungen",
                  "clickAction": "/wohnmobil-klima/klima",
                  "url": "/wohnmobil-klima/klima"
                }
              }
            }
          ]
        },
        {
          "stop": "Aus- und Einschalten bestätigt. Die Heizung meldet weiterhin eine Warnung oder Störung. Bitte am Bedienpanel prüfen; kein weiterer Neustart.",
          "error": true
        }
      ],
      "else": [
        {
          "action": "persistent_notification.create",
          "data": {
            "title": "Truma · Heizung neu starten",
            "message": "Aus- und Einschalten bestätigt; vorherige Einstellungen wiederhergestellt. Die Heizung meldet aktuell keine Warnung oder Störung. Das ist keine Garantie für eine Fehlerbehebung.",
            "notification_id": "truma_heater_restart"
          }
        },
        {
          "if": [
            {
              "condition": "template",
              "value_template": "{{ notify_service | default('') != '' }}"
            }
          ],
          "then": [
            {
              "action": "{{ notify_service }}",
              "continue_on_error": true,
              "data": {
                "title": "Truma · Heizung neu starten",
                "message": "Aus- und Einschalten bestätigt; vorherige Einstellungen wiederhergestellt. Die Heizung meldet aktuell keine Warnung oder Störung. Das ist keine Garantie für eine Fehlerbehebung.",
                "data": {
                  "tag": "truma_heater_restart",
                  "channel": "Truma Meldungen",
                  "clickAction": "/wohnmobil-klima/klima",
                  "url": "/wohnmobil-klima/klima"
                }
              }
            }
          ]
        }
      ]
    }
  ]
